# Client environment template (copy to .env for local dev or set in host dashboard for build)
# Copy: cp .env.example .env

# Backend API base URL (MUST point to your hosted backend, including /api/v1)
# Example: VITE_API_URL=https://api.wfclothings.net/api/v1
VITE_API_URL=https://your-backend-domain.com/api/v1
